@{
    ViewData["Title"] = "人事管理アプリケーション";
}
<h2 class="text-center mt-4">@ViewData["Title"]</h2>

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="d-grid gap-4 col-6 mx-auto">
            <form asp-controller="EmployeeRegister" asp-action="Enter" method="get">
                <button type="submit" class="btn btn-primary btn-lg"  style="width: 100%;">従業員登録</button>
            </form>
           
            <form asp-controller="DepartmentRegister" asp-action="Enter" method="get">
                <button type="submit" class="btn btn-primary btn-lg"  style="width: 100%;">部署登録</button>
            </form>
        </div>
    </div>
</div>