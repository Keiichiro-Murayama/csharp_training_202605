@* クラスの名前空間を指定する(C#と同じ) *@
@using src.Presentations.ViewModels
@* View が受け取るデータ型（ViewModel）を宣言asp-for はこの型のプロパティと結びつける *@
@model List<EmployeeShowListViewModel>;

@{
    ViewData["Title"] = "従業員一覧";
}
<h2 class="text-center fw-bold mt-5 mb-5">@ViewData["Title"]</h2>

<!-- Table styling -->
<style>
    table {
        width: 100%;
        text-align: center;
        border-collapse: collapse;
        border-spacing: 0;
    }

    th {
        padding: 10px;
        border-bottom: solid 4px #494c4b;
        color: #494c4b
    }

    td {
        padding: 10px;
        border-bottom: solid 1px #494c4b;
    }

    tbody tr:hover {
        background-color: #f5f5f5;
    }
</style>


<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="d-grid col-6">
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>氏名</th>
                        <th>メールアドレス</th>
                        <th>所属部署</th>
                        <th>雇用形態</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var emp in Model)
                    {
                        <tr>
                            <td>@emp.Id</td>
                            <td>@emp.Name</td>
                            <td>@emp.Email</td>
                            <td>@(emp.DepName)</td>
                            <td>@(emp.EmpStatusName)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>