@* クラスの名前空間を指定する(C#と同じ) *@
@using src.Presentations.ViewModels
@* View が受け取るデータ型（ViewModel）を宣言asp-for はこの型のプロパティと結びつける *@
@model EmployeeShowListViewModel;

@{
    ViewData["Title"] = "従業員一覧";
}
<h2 class="text-center mt-4">@ViewData["Title"]</h2>

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-4 col-sm-6">
            @foreach (var Name in Model.Name){
                @Html.DisplayFor(m=> Name )<br/>
                <hr/>
            }
        </div>
    </div>
</div>