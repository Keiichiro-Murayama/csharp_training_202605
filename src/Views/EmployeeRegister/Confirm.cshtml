@using src.Presentations.ViewModels
@model EmployeeRegisterViewModel;
@{
    ViewData["Title"] = "従業員登録(確認)";
}
<h2 class="text-center mt-4">@ViewData["Title"]</h2>
<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6 col-sm-8">
            <table class="table table-hover">
                <tbody>
                    <tr>
                        @*EmployeeRegisterViewModelのNameプロパティの値を表示する*@
                        <td class="fw-bold">@Html.DisplayNameFor(m => m.Name)</td>
                        <td>@Html.DisplayFor(m => m.Name)</td>
                    </tr>
                    <tr>
                        @*EmployeeRegisterViewModelのNameプロパティの値を表示する*@
                        <td class="fw-bold">@Html.DisplayNameFor(m => m.Email)</td>
                        <td>@Html.DisplayFor(m => m.Email)</td>
                    </tr>
                    <tr>
                         @*EmployeeRegisterViewModelのDepNameプロパティの値を表示する*@
                        <td class="fw-bold">@Html.DisplayNameFor(m => m.DepName)</td>
                        <td>@Html.DisplayFor(m => m.DepName)</td>
                    </tr>
                    <tr>
                         @*EmployeeRegisterViewModelのEmpNameプロパティの値を表示する*@
                        <td class="fw-bold">@Html.DisplayNameFor(m => m.EmpStatusName)</td>
                        <td>@Html.DisplayFor(m => m.EmpStatusName)</td>
                    </tr>
                </tbody>
            </table>    

            <form>
                @*POSTリクエスト(Register/Back)に値を渡すためにhidden属性を使う*@
                @*これがないと、次の画面で値が消えてしまう*@
                <input type="hidden" asp-for="Name" />
                <input type="hidden" asp-for="Email" />
                <input type="hidden" asp-for="DepId" />
                <input type="hidden" asp-for="DepName" />
                <input type="hidden" asp-for="EmpStatusId" />
                <input type="hidden" asp-for="EmpStatusName" />

                @*formaction/formmethod ボタンごとに送信先を変える*@
                @*同じフォーム内で[登録]と[戻る]を分岐できる*@
                <div class="text-center mt-4">
                    <button type="submit"
                        formaction="@Url.Action("Register", "EmployeeRegister")"
                        formmethod="post"
                        class="btn btn-primary">登録</button>
                    <button type="submit"
                        formaction="@Url.Action("Back", "EmployeeRegister")"
                        formmethod="post"
                        class="btn btn-secondary">戻る</button>
                </div>
            </form>
        </div>
    </div>
</div>